AMENT_PREFIX_PATH=/ws/install/stack_msgs:/opt/ros/humble
CMAKE_PREFIX_PATH=/ws/install/stack_msgs
COLCON=1
CUDA_HOME=/usr/local/cuda
DEBIAN_FRONTEND=noninteractive
FASTRTPS_DEFAULT_PROFILES_FILE=/ws/fastdds/jetson_fastdds.xml
HOME=/root
HOSTNAME=RedJetson
LC_CTYPE=C.UTF-8
LD_LIBRARY_PATH=/ws/install/stack_msgs/lib:/opt/ros/humble/lib/aarch64-linux-gnu:/opt/ros/humble/lib:/usr/local/cuda/lib64
NVIDIA_DRIVER_CAPABILITIES=all
NVIDIA_VISIBLE_DEVICES=all
OLDPWD=/ws
PATH=/opt/ros/humble/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PWD=/ws/build/health_monitor
PYTHONPATH=/ws/install/stack_msgs/local/lib/python3.10/dist-packages:/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_DISTRO=humble
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0
ROS_PYTHON_VERSION=3
ROS_VERSION=2
SHLVL=1
_=/usr/bin/colcon
